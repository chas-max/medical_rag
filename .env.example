MILVUS_URI=http://localhost:19531
COLLECTION_NAME=medical_rag_resume_chunks
# 默认为 locked：只开放脱敏的健康状态，业务接口全部关闭。
# 仅限本机虚构数据的单用户演示才可设为 unsafe-local-demo；绝不能用于生产。
MEDICAL_RAG_ACCESS_MODE=locked
# Compose 镜像可按需改为企业自建镜像仓库
MILVUS_IMAGE=docker.m.daocloud.io/milvusdb/milvus:v2.6.24
MINIO_IMAGE=docker.m.daocloud.io/minio/minio:RELEASE.2024-12-18T13-15-44Z
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 生成模型走 OpenAI 兼容协议，任何厂商都能用；QWEN_ 前缀只是保留的历史键名，
# 改名会破坏已有部署，所以不改。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
# HyDE 用于额外的向量召回，可关闭以评测基线；超时范围为 0–60 秒（不含 0）。
HYDE_ENABLED=true
HYDE_TIMEOUT_SECONDS=10
# 结构化会话状态（连续追问理解，medical-answer v7）。默认关闭，关闭时显式使用 v6。
# 患者服务不读取本文件，必须在操作员进程环境注入同名变量；两个进程要同时启用，
# 否则只启用一半链路。发布前先应用 database/migrations/0009，再显式发布 v7。
DIALOGUE_STATE_ENABLED=false
# 界面「设置 → 模型配置」确认过的模型都写在这个文件里（含明文 API Key，已被 git 忽略）。
# 其中当前选中的那条会覆盖上面的 QWEN_*，删掉文件即整体回落到 .env；改路径就设 SETTINGS_FILE。
SETTINGS_FILE=settings.json
# 问答历史与工作流 HTTP 运行结果落盘；相对路径以项目目录为基准。
CHAT_HISTORY_FILE=data/chat-history.sqlite3
# 文档异步入库：文件先可靠暂存，再由独立 Worker 处理。不要使用网络共享目录。
DOCUMENT_UPLOADS_DIR=data/document-uploads
# Compose 使用下方密码创建 medical_rag 用户和 medical-rag vhost；请替换示例密码。
# URL 中密码含 @ / : % 等保留字符时，必须先做百分号编码。
RABBITMQ_IMAGE=rabbitmq:4.3.6-management
RABBITMQ_PASSWORD=replace-with-a-strong-local-password
RABBITMQ_URL=amqp://medical_rag:replace-with-a-strong-local-password@127.0.0.1:5673/medical-rag
# 长期记忆：画像复用历史 SQLite；情景 Markdown 文件根目录（相对项目目录）。
MEMORY_EPISODES_DIR=data/memory/episodes
# 短期会话记忆：生成时带最近 3 轮 + 滚动摘要；轮次向量另存一个 Milvus 集合。
# 只有检索反馈（规则2）触发时才召回历史。SCOPE=conversation 只读当前会话；
# 改为 global 才跨会话，并按 HALF_LIFE_DAYS 做时间衰减。
CHAT_RECALL_ENABLED=true
CHAT_TURN_COLLECTION=medical_rag_chat_turns
CHAT_RECALL_TOP_K=3
CHAT_RECALL_SCOPE=conversation
CHAT_RECALL_HALF_LIFE_DAYS=7
EVIDENCE_THRESHOLD=0.5
# 入库分块：子块按 BGE 分词器计数，默认 400 token/块（硬上限 480，给 query 留出 512 窗口余量），
# 重叠 60 token（15%）；父块默认 900 token，检索命中子块后把整个父块交给生成。
# 修改这些值会改变块 ID，需要重新入库并重新映射评测题集。
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
PARENT_MAX_TOKENS=900
# 重排模型不可用时默认 fail-closed：门控拒答并返回“检索服务降级”，不拿词面分数生成答案。
# 设为 false 才允许保守放行（查询实词覆盖率 ≥ 0.6 且命中 ≥ 2 个实词）。
RERANK_FAIL_CLOSED=true
# 重排候选上限：只对 RRF 头部 RERANK_K 条打分；默认值按评测校准结果保持 15
RERANK_K=15
# 嵌入/重排模型运行设备：默认自动探测，装了 CUDA 版 torch 且 GPU 可用时走 GPU，
# 否则回退 CPU。设为 cpu|cuda|cuda:0 可强制指定（例如显存被其他任务占满时强制 CPU）
# RAG_MODEL_DEVICE=cuda
# 联网补充检索是全局内置能力：填好 TAVILY_API_KEY 后每条工作流都自动具备，节点上不再有联网开关；留空即完全关闭，问答行为与不联网时一致
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_SECONDS=10
WEB_CONTENT_MAX_CHARS=1200
# 自检门槛：最高重排分不低于 CLEAR_EVIDENCE_THRESHOLD 且证据不少于 MIN_CLEAR_EVIDENCE 条时判定为“已清晰”，直接按检索作答
# 实测本语料相关题最高分约 0.73、无关题约 0.50，故取 0.65；更换语料后需用评测集重新校准
CLEAR_EVIDENCE_THRESHOLD=0.65
MIN_CLEAR_EVIDENCE=2
MAX_AGENT_TOOL_CALLS=2
