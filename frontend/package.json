{
  "name": "medical-rag-workflow-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && eslint .",
    "format": "prettier --write src vite.config.ts eslint.config.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
