--- /dev/null
+++ b/frontend/src/test/patient-app.test.tsx
@@ -0,0 +1,738 @@
+import {
+  act,
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from "@testing-library/react";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { PatientApp } from "../patient/PatientApp";
+
+const identity = {
+  user_id: "account-own",
+  tenant_id: "institution-own",
+  roles: ["patient"],
+  binding: { verified: true },
+  permissions: { identity: true, health_consent: true, conversations: true },
+};
+const notice = {
+  notice: {
+    version: "institution-v7",
+    text: "机构完整告知 <script>private</script>",
+    validity_seconds: 3600,
+  },
+  granted: false,
+  expires_at: null,
+};
+const item = {
+  id: "00000000-0000-0000-0000-000000000001",
+  title: "私密标题",
+  created_at: "2026-01-01",
+};
+let handler: (url: string, init: RequestInit) => unknown;
+let calls: string[];
+const ok = (data: unknown) =>
+  new Response(JSON.stringify({ success: true, data, error: null }), {
+    headers: { "Content-Type": "application/json" },
+  });
+beforeEach(() => {
+  vi.spyOn(document, "hasFocus").mockReturnValue(true);
+  Object.defineProperty(document, "visibilityState", {
+    configurable: true,
+    value: "visible",
+  });
+  calls = [];
+  window.history.replaceState(null, "", window.location.pathname);
+  handler = (url) =>
+    url === "/auth/session"
+      ? { ...identity, csrf_token: "csrf-memory" }
+      : url === "/me"
+        ? identity
+        : url.includes("consents")
+          ? notice
+          : url.includes("turns")
+            ? {
+                items: [
+                  {
+                    id: item.id,
+                    content: "私密记录",
+                    created_at: item.created_at,
+                  },
+                ],
+                limit: 20,
+                offset: 0,
+              }
+            : { items: [item], limit: 20, offset: 0 };
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async (url: string, init: RequestInit) => {
+      calls.push(url);
+      const result = await handler(url, init);
+      return result instanceof Response ? result : ok(result);
+    }),
+  );
+});
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+const open = async (name: string) => {
+  await screen.findByRole("button", { name });
+  fireEvent.click(screen.getByRole("button", { name }));
+};
+it("shows only a same-origin institutional POST login after 401", async () => {
+  handler = () => new Response("secret", { status: 401 });
+  render(<PatientApp />);
+  const login = await screen.findByRole("button", { name: "机构登录" });
