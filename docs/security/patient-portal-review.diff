+input,
+textarea {
+  font: inherit;
+  padding: 0.7rem;
+  border: 1px solid #9bafb4;
+  border-radius: 0.25rem;
+  width: 100%;
+}
+textarea {
+  min-height: 8rem;
+  resize: vertical;
