+import { useCallback, useEffect, useRef, useState } from "react";
+import { object, PatientError, request } from "./client";
+
+import {
+  identity,
+  consent,
+  row,
+  rows,
+  roles,
+  type View,
+  type Identity,
+  type Consent,
+  type Row,
+} from "./model";
+export function PatientApp() {
+  const [status, setStatus] = useState("loading"),
+    [me, setMe] = useState<Identity | null>(null),
+    [view, setView] = useState<View>("identity");
+  const [notice, setNotice] = useState<Consent | null>(null),
+    [accepted, setAccepted] = useState(false),
+    [list, setList] = useState<Row[]>([]),
+    [turns, setTurns] = useState<Row[]>([]);
+  const [selected, setSelected] = useState<string | null>(null),
+    [title, setTitle] = useState(""),
+    [content, setContent] = useState(""),
+    [offset, setOffset] = useState(0),
+    [turnOffset, setTurnOffset] = useState(0),
+    [busy, setBusy] = useState(false);
+  const generation = useRef(0),
+    csrf = useRef<string | null>(null),
+    pending = useRef(false);
+  const clear = useCallback(() => {
+    generation.current++;
+    csrf.current = null;
+    pending.current = false;
+    setMe(null);
+    setNotice(null);
+    setAccepted(false);
+    setList([]);
+    setTurns([]);
+    setSelected(null);
+    setTitle("");
+    setContent("");
+    setOffset(0);
+    setTurnOffset(0);
+    setBusy(false);
+  }, []);
+  const failure = useCallback(
+    (error: unknown) => {
+      clear();
+      setStatus(
+        error instanceof PatientError && error.status === 401
+          ? "login"
+          : error instanceof PatientError && error.status === 403
+            ? "forbidden"
+            : "unavailable",
+      );
+    },
+    [clear],
+  );
+  const perform = useCallback(
+    async (operation: (live: () => boolean) => Promise<void>) => {
+      const current = generation.current;
+      const live = () => generation.current === current;
+      try {
+        await operation(live);
+      } catch (error) {
+        if (live()) failure(error);
+      }
+    },
+    [failure],
+  );
+  const refresh = useCallback(
+    (target: View = "identity") => {
+      clear();
+      setStatus("loading");
+      void perform(async (live) => {
+        const session = await request("/auth/session");
+        if (!live()) return;
+        if (
+          !object(session) ||
+          typeof session.csrf_token !== "string" ||
+          !session.csrf_token
+        )
+          throw new PatientError();
+        const own = identity(await request("/me"));
+        if (!live()) return;
+        csrf.current = session.csrf_token;
+        setMe(own);
+        setView(target);
+        setStatus("ready");
+        if (
+          target !== "identity" &&
+          !(target === "consent"
+            ? own.permissions.health_consent
+            : own.permissions.conversations)
+        ) {
+          clear();
+          setStatus("forbidden");
+          return;
+        }
+        if (target === "consent") {
+          const data = consent(await request("/me/consents/health"));
+          if (live()) setNotice(data);
+        }
+        if (target === "conversations") {
+          const data = rows(
+            await request("/conversations?limit=20&offset=0"),
+            "title",
+          );
+          if (live()) setList(data);
+        }
+      });
+    },
+    [clear, perform],
+  );
+  useEffect(() => {
+    const requested = () =>
+      window.location.hash === "#consent"
+        ? "consent"
+        : window.location.hash === "#conversations"
+          ? "conversations"
+          : "identity";
+    refresh(requested());
+    const hide = () => {
+      clear();
+      setStatus("hidden");
+    };
+    const focus = () => {
+      if (document.visibilityState !== "hidden") refresh();
+    };
+    const visibility = () => {
+      if (document.visibilityState === "hidden") hide();
+      else focus();
+    };
+    const hash = () => refresh(requested());
+    window.addEventListener("blur", hide);
+    window.addEventListener("focus", focus);
+    window.addEventListener("hashchange", hash);
+    document.addEventListener("visibilitychange", visibility);
+    return () => {
+      generation.current++;
+      window.removeEventListener("blur", hide);
+      window.removeEventListener("focus", focus);
+      window.removeEventListener("hashchange", hash);
+      document.removeEventListener("visibilitychange", visibility);
+    };
+  }, [clear, refresh]);
+  const navigate = (next: View) => {
+    if (
+      !me ||
+      (next === "consent" && !me.permissions.health_consent) ||
+      (next === "conversations" && !me.permissions.conversations)
+    ) {
+      failure(new PatientError(403));
+      return;
+    }
+    generation.current++;
+    setView(next);
+    setList([]);
+    setTurns([]);
+    setSelected(null);
+    setTitle("");
+    setContent("");
+    setNotice(null);
+    setAccepted(false);
+    setOffset(0);
+    setTurnOffset(0);
+    pending.current = false;
+    setBusy(false);
+    void perform(async (live) => {
+      if (next === "consent") {
+        const data = consent(await request("/me/consents/health"));
+        if (live()) setNotice(data);
+      }
+      if (next === "conversations") {
+        const data = rows(
+          await request("/conversations?limit=20&offset=0"),
+          "title",
+        );
+        if (live()) setList(data);
+      }
+    });
+  };
+  const mutate = (
+    operation: (token: string, live: () => boolean) => Promise<void>,
+  ) => {
+    if (pending.current || !csrf.current) return;
+    pending.current = true;
+    setBusy(true);
+    const token = csrf.current;
+    void perform(async (live) => {
+      try {
+        await operation(token, live);
+      } finally {
+        if (live()) {
+          pending.current = false;
+          setBusy(false);
+        }
+      }
+    });
+  };
+  const logout = () => {
+    const token = csrf.current;
+    clear();
+    setStatus("loading");
+    void perform(async (live) => {
+      await request("/auth/logout", "POST", undefined, token ?? undefined);
+      if (live()) setStatus("login");
+    });
+  };
+  const withdraw = () => {
+    const token = csrf.current;
+    clear();
+    setView("consent");
+    setStatus("loading");
+    void perform(async (live) => {
+      await request(
+        "/me/consents/health",
+        "DELETE",
+        undefined,
+        token ?? undefined,
+      );
+      if (live()) refresh("consent");
+    });
+  };
+  const page = (amount: number, isTurn = false) => {
+    const next = Math.min(
+      10000,
+      Math.max(0, (isTurn ? turnOffset : offset) + amount),
+    );
+    void perform(async (live) => {
+      const data = rows(
+        await request(
+          isTurn
+            ? `/conversations/${selected}/turns?limit=20&offset=${next}`
+            : `/conversations?limit=20&offset=${next}`,
+        ),
+        isTurn ? "content" : "title",
+      );
+      if (live()) {
+        if (isTurn) {
+          setTurns(data);
+          setTurnOffset(next);
+        } else {
+          setList(data);
+          setOffset(next);
+        }
+      }
+    });
+  };
+  return (
+    <div className="patient-shell">
+      <header>
+        <div className="patient-mark">机构服务 · 患者门户</div>
+        <h1>身份与会话记录</h1>
+        <p>虚构数据开发环境 · 不提供诊断或模型生成</p>
+      </header>
+      <main>
+        <p className="patient-note">
+          离开或隐藏页面会清空本页敏感内容；返回时重新验证身份与权限。闲置期间不提供即时推送撤权。
+        </p>
+        {status === "loading" && <p role="status">正在安全验证…</p>}
+        {status === "hidden" && (
+          <p role="status">页面已锁定，返回后重新验证。</p>
+        )}
+        {status === "login" && (
+          <section>
+            <h2>机构身份验证</h2>
+            <form action="/auth/login" method="post">
+              <button type="submit">机构登录</button>
+            </form>
+          </section>
+        )}
+        {status === "unavailable" && (
+          <section>
+            <p role="alert">服务暂不可用，请重试。</p>
+            <button onClick={() => refresh()}>重试</button>
+          </section>
+        )}
+        {status === "forbidden" && (
+          <section>
+            <p role="alert">403 · 当前权限不允许访问此内容。</p>
+            <button onClick={() => refresh()}>重新验证身份</button>
+          </section>
+        )}
+        {status === "ready" && me && (
+          <>
+            <nav aria-label="服务导航">
+              <button disabled={busy} onClick={() => navigate("identity")}>
+                我的身份
+              </button>
+              {me.permissions.health_consent && (
+                <button disabled={busy} onClick={() => navigate("consent")}>
+                  健康信息授权
+                </button>
+              )}
+              {me.permissions.conversations && (
+                <button
+                  disabled={busy}
+                  onClick={() => navigate("conversations")}
+                >
+                  会话记录
+                </button>
+              )}
+              <button className="patient-secondary" onClick={logout}>
+                退出登录
+              </button>
+            </nav>
+            {view === "identity" && (
+              <section>
+                <h2>我的身份</h2>
