+  box-sizing: border-box;
+}
+body {
+  margin: 0;
+}
+.patient-shell {
+  max-width: 1080px;
+  margin: auto;
+}
+header {
+  background: #113e50;
+  color: white;
+  padding: 2.5rem 2rem;
+  border-bottom: 6px solid #28a69a;
+}
+h1 {
+  font-size: clamp(1.7rem, 4vw, 2.4rem);
