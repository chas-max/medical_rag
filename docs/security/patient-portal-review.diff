+}
+nav {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.7rem;
+  margin: 1.2rem 0;
+}
+button {
+  font: inherit;
+  background: #086f6a;
+  color: #fff;
+  padding: 0.65rem 1.05rem;
+  border: 1px solid #086f6a;
+  border-radius: 0.3rem;
+  cursor: pointer;
+}
+button:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+button:hover:not(:disabled) {
+  background: #075852;
+}
+button:focus-visible,
+input:focus-visible,
+textarea:focus-visible {
+  outline: 3px solid #ba6b06;
+  outline-offset: 3px;
+}
+.patient-secondary {
+  background: #fff;
+  color: #164b60;
+}
+label {
+  display: grid;
+  gap: 0.4rem;
+  margin: 1rem 0;
+  font-weight: 600;
