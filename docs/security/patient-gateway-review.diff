+@contextmanager
+def infrastructure(directory: Path):
+    owned = Owned(directory)
+    try:
+        for image in (NGINX, "postgres:18.6-alpine", "python:3.13-alpine"):
+            docker("image", "inspect", image, "--format", "{{.Id}}")
